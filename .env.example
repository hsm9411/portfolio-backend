# ========================================
# Database Configuration
# ========================================
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/postgres

# DB 스키마 (prod: portfolio / dev: portfolio_dev)
DB_SCHEMA=portfolio

# ========================================
# Supabase Configuration (OAuth 전환)
# ========================================
# Supabase Project URL
SUPABASE_URL=https://vcegupzlmopajpqxttfo.supabase.co

# Supabase Anon (Public) Key - Frontend용
# Dashboard → Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=your_supabase_anon_key_from_dashboard

# Supabase JWT Secret - Backend JWT 검증용
# Dashboard → Settings → API → Project API keys → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_from_dashboard

# ========================================
# JWT Configuration (Local Auth용)
# ========================================
# Local 로그인 전용 JWT Secret (Supabase와 별도)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ========================================
# OAuth Configuration (Deprecated - Supabase OAuth 사용)
# ========================================
# Supabase OAuth 사용 시 아래 설정은 불필요
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=600

# ========================================
# Server Configuration
# ========================================
PORT=3000
NODE_ENV=development

# CORS: 모든 origin 허용 (*) 또는 특정 도메인 (콤마 구분)
# 개발: CORS_ORIGINS=*
# 프로덕션: CORS_ORIGINS=https://yourapp.vercel.app,https://yourdomain.com
CORS_ORIGINS=*

# ========================================
# Frontend URL
# ========================================
FRONTEND_URL=http://localhost:5173

# ========================================
# Admin Configuration
# ========================================
# 관리자 이메일 목록 (콤마 구분, SupabaseJwtStrategy에서 isAdmin 설정에 사용)
ADMIN_EMAILS=your_admin_email@example.com

# ========================================
# GitHub Webhook (BACK-28: Changelog 자동 기록)
# ========================================
# GitHub Repository → Settings → Webhooks → Secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# 레포지토리명 → 프로젝트 UUID 매핑 (JSON 형식)
# 예: {"portfolio-backend":"uuid-of-project","portfolio-frontend":"uuid-of-another-project"}
GITHUB_REPO_MAP={"your-repo-name":"your-project-uuid"}
